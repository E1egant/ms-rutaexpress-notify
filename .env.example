# Sin SPRING_PROFILES_ACTIVE: perfil dev, H2 en memoria, sin seguridad.
# SPRING_PROFILES_ACTIVE=secure exige AZURE_TENANT_ID y AZURE_API_AUDIENCE.
# Sumar "prod" activa PostgreSQL (DB_*) en vez de H2.
SPRING_PROFILES_ACTIVE=secure

AZURE_TENANT_ID=<TENANT_ID>
# Los tokens v2 traen aud = GUID de la API (no api://...)
AZURE_API_AUDIENCE=<API_CLIENT_ID>

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rutaexpress
RABBITMQ_PASS=rutaexpress

DB_HOST=localhost
DB_PORT=5432
DB_NAME=notify
DB_USER=rutaexpress
DB_PASS=rutaexpress
